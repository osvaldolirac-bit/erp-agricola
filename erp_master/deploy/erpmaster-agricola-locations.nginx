# Fragmento nginx — rubro agrícola multi-tenant (:8508)
# Sustituye locations /demo/ y /laconcepcion/ por /agricola/ + redirects.

    location = /agricola {
        return 301 /agricola/;
    }

    location /agricola/ {
        proxy_pass http://127.0.0.1:8508/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /agricola;
        proxy_read_timeout 120;
        proxy_send_timeout 120;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # Compat URLs antiguas
    location = /demo {
        return 301 /agricola/;
    }
    location = /laconcepcion {
        return 301 /agricola/;
    }
    location /demo/ {
        rewrite ^/demo/(.*)$ /agricola/$1 permanent;
    }
    location /laconcepcion/ {
        rewrite ^/laconcepcion/(.*)$ /agricola/$1 permanent;
    }
    location ~ ^/laconcepcion-v2(/.*)?$ {
        return 301 /agricola$1;
    }
