# Atajos antiguos de consola → /consola/ (incluir en server HTTPS erpmaster.cl)
location = /login {
    return 301 /consola/login;
}
location = /logout {
    return 307 /consola/logout$is_args$args;
}
location = /admin {
    return 301 /consola/admin;
}
location /plataforma/ {
    return 301 /consola$uri$is_args$args;
}
location /clientes/ {
    return 301 /consola$uri$is_args$args;
}
location /api/ {
    return 301 /consola$uri$is_args$args;
}

# Consola Master (Flask :8507)
location = /consola {
    return 301 /consola/;
}
location /consola/ {
    proxy_pass http://127.0.0.1:8507/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /consola;
    proxy_set_header X-Script-Name /consola;
    proxy_read_timeout 60;
    proxy_send_timeout 60;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
}
